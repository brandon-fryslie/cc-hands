#!/bin/sh
# Runs Python on hands' own source in this plugin, under the first Python 3.12 or newer on PATH:
#
#     hooks/python -m hands.sessions.shim
#
# The plugin has no venv, and the shim needs only the standard library and hands' data modules, so the plugin's
# src is the whole path it needs. Claude Code spawns this with no shell between (hooks.json is exec form) and the
# last line execs, so the shim is the process Claude Code spawned: its parent is the claude process whose pid it
# records. A launcher that ran Python as its child, as `uv run` does, would record its own pid instead.
root=$(cd "$(dirname "$0")/.." && pwd -P) || exit 1
for python in python3 python3.14 python3.13 python3.12; do
  if command -v "$python" >/dev/null && "$python" -I -c 'import sys; sys.exit(sys.version_info < (3, 12))'; then
    PYTHONPATH="$root/src" exec "$python" -s "$@"
  fi
done
echo "hands: no Python 3.12 or newer on PATH, so hands' hook cannot run; PATH is $PATH" >&2
exit 1
